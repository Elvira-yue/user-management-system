# 服务端口
PORT=3000

# MySQL 连接配置（请按本机实际情况修改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=user_management
DB_USER=root
DB_PASSWORD=123456

# JWT 配置（生产环境请务必替换为随机长字符串）
JWT_SECRET=ums_dev_secret_please_change_in_production
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址，多个用英文逗号分隔；留空表示允许所有来源
CORS_ORIGIN=http://localhost:5173

# 新增用户未指定密码时使用的初始密码
DEFAULT_PASSWORD=123456
